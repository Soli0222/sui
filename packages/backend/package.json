{
  "name": "@sui/backend",
  "version": "2.0.0-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @sui/db db:generate && tsx watch src/index.ts",
    "dev:run": "tsx watch src/index.ts",
    "build": "pnpm --filter @sui/db db:generate && tsup",
    "test": "pnpm --filter @sui/db db:generate && vitest run",
    "test:integration": "pnpm --filter @sui/db db:generate && vitest run --config vitest.integration.config.ts",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "performance:compare": "tsx src/performance/compare.ts",
    "test:db:migrate": "pnpm --filter @sui/db prisma:migrate",
    "typecheck": "pnpm --filter @sui/db db:generate && tsc --project tsconfig.json --noEmit",
    "prisma:generate": "pnpm --filter @sui/db db:generate",
    "prisma:migrate": "pnpm --filter @sui/db prisma:migrate",
    "db:push": "pnpm --filter @sui/db db:push"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "^2.5.1",
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sui/db": "workspace:*",
    "@sui/shared": "workspace:*",
    "hono": "^4.12.34",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@prisma/instrumentation": "7.9.1",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "oauth2-mock-server": "^9.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
