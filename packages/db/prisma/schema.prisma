generator client {
  provider              = "prisma-client"
  output                = "../src/generated/prisma"
  generatedFileExtension = "mts"
  importFileExtension   = "mts"
  moduleFormat          = "esm"
}

datasource db {
  provider = "postgresql"
}

enum RecurringItemType {
  income
  expense
  transfer
}

enum Recurrence {
  monthly
  weekly
}

enum TransactionType {
  income
  expense
  transfer
  adjustment
}

enum DateShiftPolicy {
  none
  previous
  next
}

enum LoanPaymentMethod {
  account_withdrawal
  credit_card
}

enum SplitMethod {
  equal
  ratio
  amount
}

enum SettlementKind {
  transaction
  offset
}

enum SalaryRecordKind {
  salary
  bonus
}

model Account {
  id                         String          @id @default(uuid()) @db.Uuid
  name                       String          @db.VarChar(100)
  balance                    Int
  balanceOffset              Int             @default(0) @map("balance_offset")
  lastReconciledAt           DateTime?       @map("last_reconciled_at")
  currencyCode               String          @default("JPY") @map("currency_code") @db.VarChar(3)
  exchangeRateToJpy          Float           @default(1) @map("exchange_rate_to_jpy")
  exchangeRateUpdatedAt      DateTime        @default(now()) @map("exchange_rate_updated_at")
  sortOrder                  Int             @map("sort_order")
  deletedAt                  DateTime?       @map("deleted_at")
  createdAt                  DateTime        @default(now()) @map("created_at")
  updatedAt                  DateTime        @updatedAt @map("updated_at")
  transactions               Transaction[]   @relation("account_transactions")
  incomingTransfers          Transaction[]   @relation("transfer_account_transactions")
  recurringItems             RecurringItem[] @relation("recurring_item_account")
  incomingRecurringTransfers RecurringItem[] @relation("recurring_item_transfer_to_account")
  creditCards                CreditCard[]
  loans                      Loan[]

  @@map("accounts")
}

model RecurringItem {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String            @db.VarChar(100)
  type                RecurringItemType
  amount              Int
  recurrence          Recurrence        @default(monthly) @map("recurrence")
  interval            Int               @default(1) @map("interval")
  dayOfMonth          Int?              @map("day_of_month")
  dayOfWeek           Int?              @map("day_of_week")
  accountId           String?           @map("account_id") @db.Uuid
  transferToAccountId String?           @map("transfer_to_account_id") @db.Uuid
  enabled             Boolean           @default(true)
  startDate           DateTime?         @map("start_date") @db.Date
  endDate             DateTime?         @map("end_date") @db.Date
  dateShiftPolicy     DateShiftPolicy   @default(none) @map("date_shift_policy")
  sortOrder           Int               @map("sort_order")
  deletedAt           DateTime?         @map("deleted_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  account             Account?          @relation("recurring_item_account", fields: [accountId], references: [id])
  transferToAccount   Account?          @relation("recurring_item_transfer_to_account", fields: [transferToAccountId], references: [id])

  @@map("recurring_items")
}

model CreditCard {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  settlementDay   Int?            @map("settlement_day")
  accountId       String?         @map("account_id") @db.Uuid
  assumptionAmount Int            @map("assumption_amount")
  dateShiftPolicy DateShiftPolicy @default(none) @map("date_shift_policy")
  sortOrder       Int             @map("sort_order")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  items           CreditCardItem[]
  account         Account?        @relation(fields: [accountId], references: [id])

  @@map("credit_cards")
}

model Subscription {
  id                    String     @id @default(uuid()) @db.Uuid
  name                  String     @db.VarChar(100)
  amount                Int
  currencyCode          String          @default("JPY") @map("currency_code") @db.VarChar(3)
  exchangeRateToJpy     Float           @default(1) @map("exchange_rate_to_jpy")
  exchangeRateUpdatedAt DateTime        @default(now()) @map("exchange_rate_updated_at")
  recurrence Recurrence @default(monthly) @map("recurrence")
  interval   Int        @default(1) @map("interval")
  startDate  DateTime   @map("start_date") @db.Date
  dayOfMonth     Int?       @map("day_of_month")
  dayOfWeek      Int?       @map("day_of_week")
  endDate        DateTime?  @map("end_date") @db.Date
  paymentSource  String?    @map("payment_source") @db.VarChar(100)
  deletedAt      DateTime?  @map("deleted_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SalaryRecord {
  id                  String           @id @default(uuid()) @db.Uuid
  paidOn              DateTime         @map("paid_on") @db.Date
  kind                SalaryRecordKind @default(salary)
  name                String?          @db.VarChar(100)
  grossAmount         Int              @map("gross_amount")
  healthInsurance     Int              @default(0) @map("health_insurance")
  pensionInsurance    Int              @default(0) @map("pension_insurance")
  employmentInsurance Int              @default(0) @map("employment_insurance")
  incomeTax           Int              @default(0) @map("income_tax")
  residentTax         Int              @default(0) @map("resident_tax")
  otherDeductions     Int              @default(0) @map("other_deductions")
  deletedAt           DateTime?        @map("deleted_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@map("salary_records")
}

model Donation {
  id        String    @id @default(uuid()) @db.Uuid
  recipient String    @db.VarChar(100)
  amount    Int
  memo      String?   @db.VarChar(200)
  donatedOn DateTime  @map("donated_on") @db.Date
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("donations")
}

model CreditCardBilling {
  id             String           @id @default(uuid()) @db.Uuid
  yearMonth      String           @unique @map("year_month") @db.VarChar(7)
  settlementDate DateTime?        @map("settlement_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          CreditCardItem[]

  @@map("credit_card_billings")
}

model CreditCardItem {
  id           String            @id @default(uuid()) @db.Uuid
  billingId    String            @map("billing_id") @db.Uuid
  creditCardId String            @map("credit_card_id") @db.Uuid
  amount       Int
  updatedAt    DateTime          @updatedAt @map("updated_at")
  billing      CreditCardBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  creditCard   CreditCard        @relation(fields: [creditCardId], references: [id])

  @@unique([billingId, creditCardId])
  @@map("credit_card_items")
}

model Loan {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @db.VarChar(100)
  totalAmount     Int             @map("total_amount")
  startDate       DateTime        @map("start_date") @db.Date
  paymentCount    Int             @map("payment_count")
  dateShiftPolicy DateShiftPolicy @default(none) @map("date_shift_policy")
  paymentMethod   LoanPaymentMethod @default(account_withdrawal) @map("payment_method")
  accountId       String?         @map("account_id") @db.Uuid
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  account         Account?        @relation(fields: [accountId], references: [id])

  @@map("loans")
}

model Transaction {
  id                  String          @id @default(uuid()) @db.Uuid
  accountId           String?         @map("account_id") @db.Uuid
  transferToAccountId String?         @map("transfer_to_account_id") @db.Uuid
  forecastEventId     String?         @unique @map("forecast_event_id") @db.VarChar(100)
  date                DateTime        @db.Date
  type                TransactionType
  description         String          @db.VarChar(200)
  amount              Int
  deletedAt           DateTime?       @map("deleted_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  account             Account?        @relation("account_transactions", fields: [accountId], references: [id])
  transferToAccount   Account?        @relation("transfer_account_transactions", fields: [transferToAccountId], references: [id])
  settlements         Settlement[]

  @@map("transactions")
}

model Person {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  memo        String?   @db.VarChar(200)
  sortOrder   Int       @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  shares      SplitShare[]
  settlements Settlement[]

  @@map("people")
}

model TransactionSplit {
  id          String      @id @default(uuid()) @db.Uuid
  date        DateTime    @db.Date
  description String      @db.VarChar(200)
  memo        String?     @db.VarChar(200)
  amount      Int
  method      SplitMethod
  ownRatio    Int?        @map("own_ratio")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  shares      SplitShare[]

  @@map("transaction_splits")
}

model SplitShare {
  id          String    @id @default(uuid()) @db.Uuid
  splitId     String    @map("split_id") @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  ratio       Int?
  amount      Int
  split       TransactionSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  person      Person           @relation(fields: [personId], references: [id])
  allocations SettlementAllocation[]

  @@unique([splitId, personId])
  @@map("split_shares")
}

model Settlement {
  id            String         @id @default(uuid()) @db.Uuid
  kind          SettlementKind
  personId      String         @map("person_id") @db.Uuid
  transactionId String?        @map("transaction_id") @db.Uuid
  date          DateTime       @db.Date
  note          String?        @db.VarChar(200)
  createdAt     DateTime       @default(now()) @map("created_at")
  person        Person         @relation(fields: [personId], references: [id])
  transaction   Transaction?   @relation(fields: [transactionId], references: [id])
  allocations   SettlementAllocation[]

  @@map("settlements")
}

model SettlementAllocation {
  id           String @id @default(uuid()) @db.Uuid
  settlementId String @map("settlement_id") @db.Uuid
  shareId      String @map("share_id") @db.Uuid
  amount       Int
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  share        SplitShare @relation(fields: [shareId], references: [id])

  @@unique([settlementId, shareId])
  @@map("settlement_allocations")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(300)
  status       Int
  clientSource String   @map("client_source") @db.VarChar(20)
  requestId    String?  @map("request_id") @db.VarChar(40)
  authKind     String?  @map("auth_kind") @db.VarChar(20)
  subject      String?  @map("subject") @db.VarChar(255)
  sessionId    String?  @map("session_id") @db.Uuid
  apiTokenId   String?  @map("api_token_id") @db.Uuid
  authMode     String?  @map("auth_mode") @db.VarChar(10)

  @@index([createdAt])
  @@map("audit_logs")
}

model AuthSession {
  id           String   @id @default(uuid()) @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  issuer       String   @default("") @map("issuer") @db.VarChar(255)
  subject      String   @map("subject") @db.VarChar(255)
  email        String?  @map("email") @db.VarChar(255)
  emailVerified Boolean @default(false) @map("email_verified")
  userAgent    String?  @map("user_agent") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  maxExpiresAt DateTime @map("max_expires_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("auth_sessions")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(100)
  tokenHash  String    @unique @map("token_hash")
  readOnly   Boolean   @default(false) @map("read_only")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_tokens")
}

model FurusatoSimulationInput {
  id                 String   @id @default(uuid()) @db.Uuid
  year               Int      @unique
  expectedBonusGross Int      @default(0) @map("expected_bonus_gross")
  otherIncome        Int      @default(0) @map("other_income")
  otherDeductions    Int      @default(0) @map("other_deductions")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("furusato_simulation_inputs")
}
