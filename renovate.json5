{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
  ],
  timezone: 'Asia/Tokyo',
  assignees: [
    'Soli0222',
  ],
  prConcurrentLimit: 10,
  prHourlyLimit: 20,
  "rangeStrategy": "bump",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/.+/values\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s+tag:\\s*["\'](?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    // Chart.yaml の appVersion を「公開済みの」image に追従させる。
    // 通常は release.yml が image の publish 後に appVersion を commit するので
    // ここは何も検出しない。release.yml の chart step が落ちた場合や、
    // 手動で image を publish した場合の fallback として残している。
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/.+/Chart\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*image=(?<depName>[^\\s]+)\\nappVersion:\\s*["\']?(?<currentValue>[^"\'\\s]+)["\']?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],
  // image tag / appVersion を上げたら同じ PR で chart version の patch を上げる。
  // これが無いと chart-guard の経路 B が成立しない。
  // experimental な機能なので renovate のバージョン更新時は挙動を確認する。
  bumpVersions: [
    {
      filePatterns: [
        '{{packageFileDir}}/Chart.yaml',
      ],
      matchStrings: [
        '(?:^|\\n)version:\\s*(?<version>[^\\s]+)',
      ],
      bumpType: 'patch',
    },
  ],
  "packageRules": [
    {
      description: 'chart が参照する image の追従。chart-guard が経路 B を強制するので automerge して良い',
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'charts/**',
      ],
      commitMessageTopic: 'Chart image {{depName}}',
      semanticCommitType: 'chore',
      semanticCommitScope: 'chart',
      addLabels: [
        'chart',
      ],
    },
    {
      "description": "Pin Docker image digests and GitHub Action digests for reproducibility",
      "matchManagers": ["dockerfile", "docker-compose", "github-actions"],
      "pinDigests": false,
    },
    {
      "description": "Require review for major version updates",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "reviewers": ["Soli0222"],
    },
  ],
}
